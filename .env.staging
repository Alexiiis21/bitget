# Entorno de staging. Lo carga Vite con `npm run dev:staging` (modo `staging`).
#
# Todo es real: la API de Bitget, el vault cifrado y las credenciales que se
# den de alta desde el panel. No queda ninguna pieza de simulacion en pie -el
# servicio de demostracion ni siquiera entra en el bundle- y la suite de
# pruebas se niega a ejecutarse en este entorno.
#
# Datos en:  %APPDATA%\Panel de Control Bitget-staging\
#            (carpeta propia: no comparte vault ni contraseña maestra con dev)
#
# Aqui NO van credenciales de Bitget. Las API keys se dan de alta desde la
# pantalla del panel y se guardan cifradas en vault.enc; nunca en un archivo de
# texto. docs/03-modelo-de-datos.md seccion 5.

APP_ENV=staging

# Obligatorio en staging, y la configuracion lo verifica al construir: el panel
# de staging no puede montarse sobre el servicio de demostracion.
VITE_PANEL_SERVICE=ipc
